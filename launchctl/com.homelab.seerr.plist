<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.homelab.seerr</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/opt/node@22/bin/node</string>
        <string>dist/index.js</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>/opt/seerr</string>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after a crash, but not after a clean exit (e.g. an app quitting to self-update). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/homelab.seerr.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/homelab.seerr.error.log</string>
</dict>
</plist>