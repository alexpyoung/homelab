<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.homelab.plex</string>
    <!-- Wait for Lucy: at boot it can mount after login, and the app would start without media. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>until [ -d /Volumes/Lucy/torrents ]; do sleep 5; done; exec "$0"</string>
        <string>/Applications/Plex Media Server.app/Contents/MacOS/Plex Media Server</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart after a crash, but not after a clean exit (e.g. an app quitting to self-update). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/usr/local/var/log/homelab.plex.log</string>
    <key>StandardErrorPath</key>
    <string>/usr/local/var/log/homelab.plex.error.log</string>
</dict>
</plist>