# Copy to .env (gitignored). Read by docker compose for the homepage container.
# Radarr/Sonarr/Prowlarr: Settings -> General -> API Key
HOMEPAGE_VAR_RADARR_KEY=
HOMEPAGE_VAR_SONARR_KEY=
HOMEPAGE_VAR_PROWLARR_KEY=
# Seerr: Settings -> General -> API Key
HOMEPAGE_VAR_SEERR_KEY=
# Plex: https://support.plex.tv/articles/204059436
HOMEPAGE_VAR_PLEX_TOKEN=
# qBittorrent Web UI login
HOMEPAGE_VAR_QBITTORRENT_USERNAME=
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=
